{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "folio-license",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "durable_objects": {
    "bindings": [{ "name": "LICENSE_STORE", "class_name": "LicenseStore" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseStore"] }],
  // Local `wrangler dev` values. Secrets go in .dev.vars (see .dev.vars.example).
  "vars": {
    "FOLIO_LICENSE_PUBLIC_KEY": "REPLACE_WITH_BASE64_PUBLIC_KEY",
    "FOLIO_PRODUCT_ID": "pdt_0Nq1EUkyJ4XjGzf8ordZ1",
    "EMAIL_FROM": "Folio <license@example.com>"
  },
  "env": {
    // Dodo test mode. Own Durable Object storage, so test orders never mix with live ones.
    "test": {
      "name": "folio-license-test",
      "durable_objects": {
        "bindings": [{ "name": "LICENSE_STORE", "class_name": "LicenseStore" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseStore"] }],
      "vars": {
        "FOLIO_LICENSE_PUBLIC_KEY": "REPLACE_WITH_BASE64_PUBLIC_KEY",
        "FOLIO_PRODUCT_ID": "pdt_0Nq1EUkyJ4XjGzf8ordZ1",
        "EMAIL_FROM": "Folio <license@example.com>"
      }
    },
    "production": {
      "name": "folio-license",
      "durable_objects": {
        "bindings": [{ "name": "LICENSE_STORE", "class_name": "LicenseStore" }]
      },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["LicenseStore"] }],
      "vars": {
        "FOLIO_LICENSE_PUBLIC_KEY": "REPLACE_WITH_BASE64_PUBLIC_KEY",
        "FOLIO_PRODUCT_ID": "REPLACE_WITH_LIVE_PRODUCT_ID",
        "EMAIL_FROM": "Folio <license@example.com>"
      }
    }
  }
}
