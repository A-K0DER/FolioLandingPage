---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Something Went Wrong" description="Something went wrong on our end. Please try again." noindex>
  <section class="container-x py-32 text-center">
    <p class="eyebrow">500</p>
    <h1 class="display mt-4 !text-5xl">Something went wrong.</h1>
    <p class="lead mx-auto mt-4 max-w-xl">It's a problem on our end, not yours. Please try again in a moment, or contact support if it keeps happening.</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/" class="btn-primary">Back Home</a>
      <a href="/support/" class="btn-secondary">Get Support</a>
    </div>
  </section>
</Layout>
