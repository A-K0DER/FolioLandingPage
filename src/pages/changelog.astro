---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
const releases = [{ v: site.version, date: site.releaseDate, notes: ['Initial release.'] }]; // TODO: add releases
const fmt = (d: string) => new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(d));
---
<Layout title="Changelog" description="Release notes for Folio, the Finder alternative for Mac.">
  <section class="container-x max-w-3xl py-24">
    <p class="eyebrow">Changelog</p><h1 class="display mt-4 !text-5xl">What's new.</h1>
    <div class="mt-12 space-y-10">
      {releases.map((r) => (
        <article class="border-t border-hairline pt-6"><h2 class="text-xl">v{r.v}</h2><time datetime={r.date} class="text-sm text-mute">{fmt(r.date)}</time><ul class="mt-3 list-disc space-y-1 pl-5 text-sm">{r.notes.map((n) => <li>{n}</li>)}</ul></article>
      ))}
    </div>
  </section>
</Layout>
