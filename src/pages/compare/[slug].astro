---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { site, rivals } from '../../data/site';

export function getStaticPaths() {
  return rivals.map((r) => ({ params: { slug: r.slug }, props: { r } }));
}
const { r } = Astro.props;
const path = `/compare/${r.slug}/`;
const folio: [string, string][] = [
  ['Layout', 'One Explorer-style window with tabs, address bar, sidebar and details pane'],
  ['Search', 'Plain-English queries become removable filter chips (file names only)'],
  ['File safety', 'Delete goes to the Trash, nothing overwritten silently, every operation can be undone'],
  ['Folder tools', 'Quick Open (⌘P) and per-folder sort and columns'],
  ['Other', 'Operations queue with progress and cancel'],
  ['Extras', 'Operations queue with progress and cancel, group by category, storage breakdown'],
  ['Archives', 'Look inside and extract ZIP, TAR and 7Z; compress to ZIP'],
  ['Price', `${site.price.label}, one-time, one Mac per license`],
  ['Price and status', `${site.price.label} one-time; released as version ${site.version}`],
  ['Minimum macOS', site.minMacOS],
  ['Privacy', 'No analytics or tracking; the internet is used only to activate or deactivate'],
  ['Platforms', `Built only for Mac (${site.minMacOS} or later)`],
];
const checked = 'checked' in r ? r.checked : 'October 18, 2026';
const folioFor: Record<string, string> = Object.fromEntries(folio);
// Folio features with no matching row in the rival's list, so they are not left out of the table.
const folioOnly: [string, string][] = [
  ['Group by Category', 'Splits a folder into ten kinds (Videos, Images, PDFs and more) with fold-away headers showing item count and size (⌃⌘G)'],
  ['Storage breakdown', 'With nothing selected, the details pane shows a coloured bar and list of space used by category, including subfolders'],
];
const faqs = [
  [`Is Folio a ${r.name} alternative?`, `Folio is a Mac Finder alternative that some people use instead of ${r.name}. See whether it fits how you work.`],
  [`Is Folio free like some ${r.name} alternatives?`, `No. Folio is a one-time ${site.price.label} license.`],
  ['Can I use Folio with Finder?', 'Yes. Folio works alongside Finder, so you can switch back at any time.'],
];
const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'WebPage', name: `Folio vs ${r.name}`, url: `${site.url}${path}` },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Layout title={r.kw} description={r.desc} jsonLd={jsonLd}>
  <section class="container-x max-w-4xl py-24">
    <p class="eyebrow">Compare</p>
    <h1 class="display mt-4 !text-5xl sm:!text-6xl">{r.h1}</h1>
    <p class="lead mt-5 max-w-2xl">{r.intro}</p>
    <p class="mt-4 max-w-2xl text-base leading-7">{r.who}</p>

    <h2 class="h2 mt-16">Folio vs {r.name}</h2>
    <div class="mt-6 overflow-x-auto rounded-md border border-hairline bg-elevated">
      <table class="w-full min-w-xl text-left text-sm">
        <caption class="sr-only">Folio compared with {r.name}</caption>
        <thead class="border-b border-hairline bg-canvas text-ink"><tr><th scope="col" class="px-5 py-3 font-medium">&nbsp;</th><th scope="col" class="px-5 py-3 font-medium" translate="no">Folio</th><th scope="col" class="px-5 py-3 font-medium" translate="no">{r.name}</th></tr></thead>
        <tbody class="divide-y divide-hairline">
          {r.rows.map(([k, v]) => <tr><th scope="row" class="px-5 py-3 font-medium text-ink">{k}</th><td class="px-5 py-3">{folioFor[k] ?? 'Not a listed Folio feature'}</td><td class="px-5 py-3">{v}</td></tr>)}
          {folioOnly.map(([k, v]) => <tr><th scope="row" class="px-5 py-3 font-medium text-ink">{k}</th><td class="px-5 py-3">{v}</td><td class="px-5 py-3 text-mute">Not listed on its site</td></tr>)}
        </tbody>
      </table>
    </div>
    <p class="mt-3 text-xs text-mute">{r.name} details from {r.asOf}, checked {checked}. Features and prices change, so confirm on the official site. Product names belong to their owners.</p>

    <h2 class="h2 mt-16">Which should you choose?</h2>
    <p class="mt-4 max-w-2xl text-base leading-7">{r.pick}</p>

    <h2 class="h2 mt-16">How to choose</h2>
    <p class="mt-4 max-w-2xl text-base leading-7">Write down what you do every day, such as searching, moving large batches, browsing archives or working across folders. Then try each app against that list. Folio is a good fit when safe file operations, quick search and a clear price matter most. Read <a href="/best-mac-file-manager/" class="text-link underline underline-offset-4">how to choose the best Mac file manager</a>, or see the <a href="/compare/commander-one-alternative/" class="text-link underline underline-offset-4">Commander One comparison</a>.</p>

    <h2 class="h2 mt-16">Questions</h2>
    <div class="mt-6 divide-y divide-hairline border-y border-hairline">
      {faqs.map(([q, a]) => (
        <details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink">{q}<span class="text-mute transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-3 text-sm leading-6">{a}</p></details>
      ))}
    </div>
  </section>
  <CTA />
</Layout>
