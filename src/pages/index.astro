---
import Layout from '../layouts/Layout.astro';
import AppWindow from '../components/AppWindow.astro';
import CTA from '../components/CTA.astro';
import AppleIcon from '../components/AppleIcon.astro';
import GatekeeperNote from '../components/GatekeeperNote.astro';
import { site, featurePages } from '../data/site';

const pillars = [
  { t: 'Search in plain English', d: '"pdfs bigger than 10 MB modified last week", on a folder or This Mac, with removable filter chips. Searches file names only.' },
  { t: 'Your files stay safe', d: 'Delete goes to the Trash, nothing is overwritten silently, and every operation can be undone.' },
  { t: 'Quick Open', d: 'Press ⌘P and jump to any folder by typing a few letters.' },
  { t: 'Archives', d: 'Extract ZIP, TAR and 7Z, and look inside them before extracting.' },
  { t: 'Explorer-style layout', d: 'Tabs, a clickable address bar, a sidebar with drives and eject, a status bar and a details pane.' },
  { t: 'Storage breakdown', d: 'See what is filling a folder, split by category, right in the details pane.' },
  { t: 'List to large icons', d: 'One slider covers every view. Sort and columns are remembered per folder, and tabs reopen at launch.' },
];
const jsonLd = {
  '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: site.name,
  applicationCategory: 'UtilitiesApplication', operatingSystem: site.minMacOS + ' or later',
  description: site.description, softwareVersion: site.version, url: site.url,
  offers: { '@type': 'Offer', price: site.price.amount, priceCurrency: site.price.currency },
};
const faqs = [
  ['What is the best Mac Finder alternative?', 'It depends on what you need. Folio is a Mac Finder alternative for people who want tabs, plain-English search, Quick Open and undoable file operations in one app. Compare it with Finder and other Mac file managers.'],
  ['Is there a free Mac Finder alternative?', 'No. Folio is a one-time paid license. It is not a free or open-source app.'],
  ['How is Folio different from Commander One, ForkLift, Path Finder or Marta?', 'Those are established Mac file managers with their own strengths. Folio focuses on plain-English search, safe file operations and a familiar Explorer-style layout, with the price shown up front. See our Commander One comparison for details.'],
  ['Is there a Windows Explorer for Mac?', 'Folio is the closest thing: an Explorer-style file manager for Mac with tabs, a clickable address bar, a sidebar with drives and eject, a details pane and a status bar.'],
  ['Does Folio have a subscription?', `No. Folio is a one-time purchase of ${site.price.label} per license, for one Mac. You can move the license to another Mac by deactivating the first.`],
  ['Why does macOS say Folio is from an unidentified developer?', 'Folio is made by a solo indie developer and is not yet notarized by Apple, so macOS shows a warning on first launch. It is expected. Right-click Folio, choose Open, then Open again. On newer macOS versions, use Open Anyway in System Settings. See the install guide on the download page.'],
  ['Can I still use Finder?', 'Yes. Folio sits alongside Finder, so you can use either whenever you like.'],
];
const faqLd = { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) };
---
<Layout title={`Mac Finder Alternative: Tabbed File Manager, ${site.price.label} Once`} description={`Folio is a tabbed file manager for Mac with an Explorer-style layout, a clickable address bar, plain-English search and undo. A one-time ${site.price.label} Finder alternative, no subscription.`} jsonLd={[jsonLd, faqLd]}>
  <section class="relative overflow-hidden">
    <div class="mesh pointer-events-none absolute inset-x-0 -top-10 h-130" aria-hidden="true"></div>
    <div class="container-x relative pb-16 pt-20 text-center sm:pt-28">
      <p class="eyebrow rise">Tabbed file manager for macOS</p>
      <h1 class="display rise mx-auto mt-5 max-w-4xl" style="animation-delay:60ms">The Mac Finder alternative with tabs, search and&nbsp;undo.</h1>
      <p class="lead rise mx-auto mt-6 max-w-2xl" style="animation-delay:120ms"><span translate="no">{site.name}</span> is a Finder alternative with an Explorer-style layout: tabs, a clickable address bar, plain-English search and undo for every file operation. One purchase, no subscription.</p>
      <div class="rise mt-9 flex flex-col items-center justify-center gap-3 sm:flex-row" style="animation-delay:180ms">
        <a href="/download/" class="btn-primary w-full sm:w-auto"><AppleIcon />Download for Mac</a>
        <a href="/pricing/" class="btn-secondary w-full sm:w-auto">Buy for {site.price.label}</a>
      </div>
      <p class="mt-4 text-sm text-mute">{site.minMacOS} or later · one Mac per license · {site.price.label} once</p>
      <GatekeeperNote class="mx-auto mt-2 max-w-md" />
    </div>
    <div class="container-x relative max-w-5xl pb-24"><AppWindow /></div>
  </section>

  <section class="border-t border-hairline" aria-labelledby="explorer-layout">
    <div class="container-x grid gap-10 py-24 lg:grid-cols-2 lg:items-start">
      <div>
        <p class="eyebrow">Windows Explorer for Mac</p>
        <h2 id="explorer-layout" class="h2 mt-3">An Explorer-style file manager for Mac</h2>
        <p class="lead mt-4">Moving over from Windows, or just tired of guessing where you are? <span translate="no">{site.name}</span> gives macOS the structure of Windows Explorer, built natively for {site.minMacOS} or later.</p>
      </div>
      <ul class="space-y-3 text-base leading-7">
        <li><strong class="text-ink">Tabs that come back.</strong> Keep project folders open in tabs and have them reopen at launch, like a tabbed file manager should.</li>
        <li><strong class="text-ink">A clickable address bar.</strong> The full path is always visible. Click any folder in the breadcrumbs to jump straight there.</li>
        <li><strong class="text-ink">Sidebar with drives and eject.</strong> External drives sit in the sidebar with an eject button beside them.</li>
        <li><strong class="text-ink">Details pane and status bar.</strong> Size, dates and item counts stay on screen, so you never open Get Info just to check a file.</li>
        <li><strong class="text-ink">Storage breakdown.</strong> A folder size analyzer for Mac, built in: see which categories use the space, without leaving the folder.</li>
      </ul>
    </div>
  </section>

  <section class="border-t border-hairline">
    <div class="container-x py-24">
      <p class="eyebrow">Why Folio</p>
      <h2 class="h2 mt-3 max-w-2xl">Built around your files' safety.</h2>
      <div class="mt-12 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {pillars.map((p) => (
          <article class="card"><h3 class="text-xl leading-7 tracking-[-0.02em]">{p.t}</h3><p class="mt-2 text-sm leading-6">{p.d}</p></article>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-hairline">
    <div class="container-x grid gap-10 py-24 lg:grid-cols-2 lg:items-center">
      <div>
        <p class="eyebrow">Pricing, upfront</p>
        <h2 class="h2 mt-3">A Mac file manager with no subscription.</h2>
        <p class="lead mt-4">Pay {site.price.label} once for <span translate="no">{site.name}</span>, one Mac per license. No subscription, no App Store, no analytics, no tracking.</p>
        <div class="mt-6 flex gap-3"><a href="/pricing/" class="btn-sm">See Pricing</a><a href="/compare/commander-one-alternative/" class="btn-sm-ghost">Folio vs Commander One</a></div>
      </div>
      <div class="card p-8">
        <p class="eyebrow">License</p>
        <p class="mt-3 text-6xl font-semibold tracking-[-0.05em] text-ink">{site.price.label}</p>
        <ul class="mt-6 space-y-2 text-sm">
          <li>✓ One-time payment, no subscription</li><li>✓ One Mac per license, movable by deactivating</li><li>✓ Sold directly, no App Store</li><li>✓ No analytics or tracking</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="border-t border-hairline">
    <div class="container-x py-24">
      <p class="eyebrow">Explore</p>
      <div class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {featurePages.map((f) => (
          <a href={`/features/${f.slug}/`} class="card transition-colors hover:bg-hairline-soft"><h3 class="text-base">{f.title}</h3><p class="mt-1 text-sm">{f.blurb}</p></a>
        ))}
      </div>
    </div>
  </section>

  <section class="border-t border-hairline" aria-labelledby="about-folio">
    <div class="container-x max-w-3xl py-24">
      <p class="eyebrow">About Folio</p>
      <h2 id="about-folio" class="h2 mt-3">A Mac Finder alternative for everyday file management</h2>
      <div class="mt-6 space-y-5 text-base leading-7">
        <p>Finder is fine until your work outgrows it. If you move, rename and search through hundreds of files a day, you have probably wondered whether a better Mac file manager exists. <span translate="no">{site.name}</span> is our answer: a Mac Finder alternative that keeps what you know and fixes what slows you down.</p>

        <h3 class="pt-4 text-xl tracking-[-0.02em] text-ink">What is a Mac file manager app?</h3>
        <p>A file manager app is where you browse, organize, copy, move and find files. Finder ships with every Mac, but many people want more from their file manager on Mac: real tabs, a clickable address bar, a details pane and faster ways to jump around. <span translate="no">{site.name}</span> brings an Explorer-style layout to macOS, so the file manager feels familiar from the first minute.</p>

        <h3 class="pt-4 text-xl tracking-[-0.02em] text-ink">Search that understands plain English</h3>
        <p>Type "pdfs bigger than 10 MB modified last week" and <span translate="no">{site.name}</span> turns it into filters you can see and remove. Search a single folder or all of This Mac. Search looks at file names only, so results are predictable. Press ⌘P for Quick Open and jump to any folder by typing a few letters.</p>

        <h3 class="pt-4 text-xl tracking-[-0.02em] text-ink">Safe by design</h3>
        <p>The best file manager is one you can trust. Delete sends items to the Trash, nothing is overwritten silently, and every operation can be undone. Browsing never downloads iCloud files that are not already on your Mac. There is no analytics or tracking, and your files never leave your computer.</p>

        <h3 class="pt-4 text-xl tracking-[-0.02em] text-ink">Tabs, views and archives</h3>
        <p>Open several folders in tabs and have them reopen at launch. One slider takes you from list view to large icons, and sort order and columns are remembered per folder. Extract ZIP, TAR and 7Z archives, and look inside them before you extract.</p>

        <h3 class="pt-4 text-xl tracking-[-0.02em] text-ink">Who is Folio for?</h3>
        <p>Designers sorting exports, developers juggling project folders, photographers cleaning up shoots and anyone who lives in their Downloads folder will notice the difference. If you have ever lost a file to a stray drag or an accidental delete, the undo support alone makes the switch worth trying. Because <span translate="no">{site.name}</span> works alongside Finder, there is nothing to migrate and no risk in giving it a go. Your files stay exactly where they are, and you can go back to Finder at any moment.</p>

        <h3 class="pt-4 text-xl tracking-[-0.02em] text-ink">Why look beyond Finder?</h3>
        <p>People most often look for a Finder replacement because they want a faster way to find things, better multitasking across folders and more confidence when moving large batches of files. A good Mac file manager should save you clicks every day, not add new things to learn.</p>

        <h3 class="pt-4 text-xl tracking-[-0.02em] text-ink">How Folio compares with other Mac Finder alternatives</h3>
        <p>Commander One, ForkLift, Path Finder and Marta are well-known names, and each suits different people. If you are comparing the best Mac Finder alternatives, we suggest listing what you do every day, such as dual panes, remote connections or search, and trying each app against that list. <span translate="no">{site.name}</span> is built for people who value safe operations, fast search and a clear price. Read our <a href="/compare/commander-one-alternative/" class="text-link underline underline-offset-4">Folio vs Commander One comparison</a>, or the <a href="/compare/forklift-alternative/" class="text-link underline underline-offset-4">ForkLift</a>, <a href="/compare/path-finder-alternative/" class="text-link underline underline-offset-4">Path Finder</a> and <a href="/compare/marta-alternative/" class="text-link underline underline-offset-4">Marta</a> pages, or our guide to the <a href="/best-mac-file-manager/" class="text-link underline underline-offset-4">best Mac file manager</a>.</p>

        <h3 class="pt-4 text-xl tracking-[-0.02em] text-ink">Pricing</h3>
        <p>If you are searching for a free or open-source Mac Finder alternative, note that <span translate="no">{site.name}</span> is commercial software. It is a one-time {site.price.label} license, sold directly with no App Store account needed. It runs on {site.minMacOS} or later.</p>

        <p>Ready to switch? <a href="/download/" class="text-link underline underline-offset-4">Download {site.name} for Mac</a> (unsigned for now, so right-click and choose Open the first time) and see whether it is the file manager you have been missing, or read how it works on the <a href="/features/finder-alternative/" class="text-link underline underline-offset-4">Finder alternative</a> feature page.</p>
      </div>

      <h2 class="h2 mt-16">Frequently asked questions</h2>
      <div class="mt-6 divide-y divide-hairline border-y border-hairline">
        {faqs.map(([q, a]) => (
          <details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink">{q}<span class="text-mute transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-3 text-sm leading-6">{a}</p></details>
        ))}
      </div>
    </div>
  </section>
  <CTA />
</Layout>
