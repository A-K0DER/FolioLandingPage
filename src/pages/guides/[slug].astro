---
import Layout from '../../layouts/Layout.astro';
import CTA from '../../components/CTA.astro';
import { site, guides, featurePages } from '../../data/site';

export function getStaticPaths() {
  return guides.map((g) => ({ params: { slug: g.slug }, props: { g } }));
}
const { g } = Astro.props;
const path = `/guides/${g.slug}/`;
const feature = featurePages.find((f) => f.slug === g.feature);
const related = guides.filter((x) => x.slug !== g.slug).slice(0, 3);
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'HowTo', name: g.title, description: g.desc, url: `${site.url}${path}`,
    step: g.folio.map((text, i) => ({ '@type': 'HowToStep', position: i + 1, text })),
  },
  { '@context': 'https://schema.org', '@type': 'FAQPage', mainEntity: g.faqs.map(([q, a]) => ({ '@type': 'Question', name: q, acceptedAnswer: { '@type': 'Answer', text: a } })) },
];
---
<Layout title={g.title} description={g.desc} jsonLd={jsonLd}>
  <section class="container-x max-w-3xl py-24">
    <p class="eyebrow">Guide</p>
    <h1 class="display mt-4 !text-5xl sm:!text-6xl">{g.h1}</h1>
    <p class="lead mt-5">{g.intro}</p>

    <h2 class="h2 mt-16">In Finder</h2>
    <ol class="mt-6 list-decimal space-y-3 pl-6 text-base leading-7">
      {g.finder.map((s) => <li>{s}</li>)}
    </ol>

    <h2 class="h2 mt-16">In <span translate="no">{site.name}</span></h2>
    <ol class="mt-6 list-decimal space-y-3 pl-6 text-base leading-7">
      {g.folio.map((s) => <li>{s}</li>)}
    </ol>
    {feature && <p class="mt-6 text-base leading-7">Learn more: <a href={`/features/${feature.slug}/`} class="text-link underline underline-offset-4">{feature.title}</a>. <a href="/download/" class="text-link underline underline-offset-4">Download Folio</a> for {site.minMacOS} or later, {site.price.label} one-time.</p>}

    <h2 class="h2 mt-16">Questions</h2>
    <div class="mt-6 divide-y divide-hairline border-y border-hairline">
      {g.faqs.map(([q, a]) => (
        <details class="group py-5"><summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-base font-medium text-ink">{q}<span class="text-mute transition-transform group-open:rotate-45" aria-hidden="true">+</span></summary><p class="mt-3 text-sm leading-6">{a}</p></details>
      ))}
    </div>

    <h2 class="h2 mt-16">More guides</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2">
      {related.map((x) => <li><a href={`/guides/${x.slug}/`} class="card block transition-colors hover:bg-hairline-soft"><span class="text-base font-medium text-ink">{x.title}</span></a></li>)}
    </ul>
  </section>
  <CTA />
</Layout>
