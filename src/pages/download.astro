---
import Layout from '../layouts/Layout.astro';
import { site } from '../data/site';
const date = new Intl.DateTimeFormat('en-US', { dateStyle: 'long', timeZone: 'UTC' }).format(new Date(site.releaseDate));
---
<Layout title="Download Folio for Mac" description={`Download Folio ${site.version} for ${site.minMacOS} or later.`}>
  <section class="container-x max-w-3xl py-24">
    <p class="eyebrow">Download</p>
    <h1 class="display mt-4 !text-5xl sm:!text-6xl">Download <span translate="no">{site.name}</span> for&nbsp;Mac.</h1>
    <p class="lead mt-5">Version {site.version} · {date}.</p>
    <div class="mt-8 flex flex-col gap-3 sm:flex-row"><a href={site.downloadUrl} class="btn-primary">Download .dmg</a><a href={site.checkoutUrl} class="btn-secondary">Buy a License</a></div>
    <dl class="mt-12 divide-y divide-hairline rounded-md border border-hairline bg-elevated text-sm">
      {[['Requires', `${site.minMacOS} or later`], ['Price', `${site.price.label} per license (one Mac)`]].map(([k, v]) => (
        <div class="flex justify-between gap-4 px-5 py-3"><dt class="text-mute">{k}</dt><dd class="text-ink">{v}</dd></div>
      ))}
    </dl>
  </section>
</Layout>
