---
import { site } from '../data/site';
import AppleIcon from './AppleIcon.astro';
import GatekeeperNote from './GatekeeperNote.astro';
import RefundBadge from './RefundBadge.astro';
---
<section class="border-t border-hairline">
  <div class="container-x py-24 text-center">
    <h2 class="display mx-auto max-w-3xl !text-4xl sm:!text-6xl">Stop fighting Finder.</h2>
    <p class="lead mx-auto mt-5 max-w-xl">Get <span translate="no">{site.name}</span> for {site.price.label}, one license per Mac.</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/download/" class="btn-primary w-full sm:w-auto"><AppleIcon />Download for Mac</a>
      <a href="/pricing/" class="btn-secondary w-full sm:w-auto">See Pricing</a>
    </div>
    <RefundBadge class="mt-4 justify-center" />
    <GatekeeperNote class="mx-auto mt-4 max-w-md" />
  </div>
</section>
