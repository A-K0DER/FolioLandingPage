---
import { site } from '../data/site';
---
<section class="border-t border-hairline">
  <div class="container-x py-24 text-center">
    <h2 class="display mx-auto max-w-3xl !text-4xl sm:!text-6xl">Stop fighting Finder.</h2>
    <p class="lead mx-auto mt-5 max-w-xl">Try <span translate="no">{site.name}</span> free{site.trialDays ? ` for ${site.trialDays} days` : ''}. Then a license is needed.</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-3 sm:flex-row">
      <a href="/download/" class="btn-primary w-full sm:w-auto">Download for Mac</a>
      <a href="/pricing/" class="btn-secondary w-full sm:w-auto">See Pricing</a>
    </div>
  </div>
</section>
